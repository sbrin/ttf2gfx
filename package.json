{
    "name": "truetype2gfx",
    "version": "1.1.0",
    "description": "Convert TTF, OTF, WOFF to Adafruit GFX header file",
    "main": "index.js",
    "author": "Mikhail Ilin",
    "license": "MIT",
    "type": "module",
    "module": "dist/truetype2gfx.min.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/truetype2gfx.min.js",
            "types": "./dist/types/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "prebuild": "npm run clean",
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "jsdom": "^26.1.0",
        "rollup": "^4.62.4",
        "rollup-plugin-typescript2": "^0.36.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "dependencies": {
        "@types/opentype.js": "^1.3.10",
        "opentype.js": "1.3.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sbrin/ttf2gfx.git"
    },
    "keywords": [
        "fontconvert",
        "adafruit_gfx",
        "truetype",
        "ttf2gfx",
        "gfx"
    ],
    "bugs": {
        "url": "https://github.com/sbrin/ttf2gfx/issues"
    },
    "homepage": "https://github.com/sbrin/ttf2gfx#readme"
}
